{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.153.json",
  "name": "Cortnes Light",
  "dataColors": [
    "#0EA0C6",
    "#E47511",
    "#0A2F45",
    "#33A06A",
    "#D9585F",
    "#8E6FC0",
    "#B38F1D",
    "#D574A4"
  ],
  "good": "#1E8A5E",
  "neutral": "#A56C00",
  "bad": "#C63D3D",
  "maximum": "#0A2F45",
  "center": "#10B1DA",
  "minimum": "#AFDCEE",
  "null": "#C9D6DE",
  "firstLevelElements": "#0A2F45",
  "secondLevelElements": "#33566B",
  "thirdLevelElements": "#E1EAF0",
  "fourthLevelElements": "#7A93A3",
  "background": "#FFFFFF",
  "secondaryBackground": "#C7D6E0",
  "tableAccent": "#10B1DA",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI",
      "color": "#0A2F45"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI",
      "color": "#0A2F45"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "color": "#33566B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#33566B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "wordWrap": true
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1EAF0"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "foreground": {
              "solid": {
                "color": "#33566B"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "border": {
              "solid": {
                "color": "#E1EAF0"
              }
            },
            "transparency": 0
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0A2F45"
              }
            },
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "bold": true,
            "fontSize": 13,
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#33566B"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#33566B"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#E1EAF0"
              }
            },
            "gridlineStyle": "solid"
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#33566B"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#33566B"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#E1EAF0"
              }
            },
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#33566B"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#33566B"
              }
            }
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "foregroundColor": {
              "solid": {
                "color": "#0A2F45"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#E1EAF0"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#C7D6E0"
              }
            }
          },
          {
            "$id": "Available",
            "foregroundColor": {
              "solid": {
                "color": "#33566B"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#E1EAF0"
              }
            }
          }
        ]
      }
    },
    "table": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E1EAF0"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#C7D6E0"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridVerticalColor": {
              "solid": {
                "color": "#F4F8FA"
              }
            },
            "gridHorizontal": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#F4F8FA"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#C7D6E0"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#33566B"
              }
            },
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "bold": true,
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#0A2F45"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#0A2F45"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#0A2F45"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridVerticalColor": {
              "solid": {
                "color": "#F4F8FA"
              }
            },
            "gridHorizontal": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#F4F8FA"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#C7D6E0"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#33566B"
              }
            },
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "bold": true,
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#33566B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#0A2F45"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#0A2F45"
              }
            }
          }
        ],
        "rowTotal": [
          {
            "fontColor": {
              "solid": {
                "color": "#0A2F45"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "applyToHeaders": true
          }
        ],
        "columnTotal": [
          {
            "fontColor": {
              "solid": {
                "color": "#0A2F45"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "applyToHeaders": true
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#0A2F45"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0A2F45"
              }
            },
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "bold": true
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#33566B"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F8FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F8FA"
              }
            }
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "title": [
          {
            "fontSize": 15,
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "bold": true,
            "heading": "Normal"
          }
        ],
        "subTitle": [
          {
            "fontSize": 13,
            "heading": "Normal"
          }
        ],
        "fill": [
          {
            "$id": "default",
            "fillColor": {
              "solid": {
                "color": "#F7F7F7"
              }
            }
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#0A2F45"
              }
            }
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#0A2F45"
              }
            }
          },
          {
            "$id": "disabled",
            "fillColor": {
              "solid": {
                "color": "#0A2F45"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "bold": true
          }
        ],
        "referenceLabelValue": [
          {
            "valueFontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "valueBold": true
          }
        ]
      }
    }
  }
}