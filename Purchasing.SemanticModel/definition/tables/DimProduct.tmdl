/// The product catalogue: one row per product, with its brand and division.
table DimProduct
	lineageTag: 1c4e0be0-9f91-430f-97d3-a6c96c3e9e86

	/// Product code. Text on purpose: Power BI offers the slicer search box only on a text column. FactInvoiceLine[ProductId] is text for the same reason and must stay in step with it.
	column ProductId
		dataType: string
		isKey
		isAvailableInMdx: false
		lineageTag: 756f955a-d2aa-403b-abb4-131d30549f68
		summarizeBy: none
		sourceColumn: ProductId

		annotation SummarizationSetBy = Automatic

	/// Product name as it appears in the catalogue. Sorted by ProductSortOrder.
	column ProductName
		dataType: string
		isAvailableInMdx: false
		lineageTag: 5cd6dc67-9ff1-4abb-b030-85c722f5365a
		isDefaultLabel
		summarizeBy: none
		sourceColumn: ProductName
		sortByColumn: ProductSortOrder

		annotation SummarizationSetBy = Automatic

	/// Display order of ProductName, from the source: one position per product name.
	column ProductSortOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 25d5962c-8d27-4e9f-b02e-f9eb2064af39
		summarizeBy: none
		sourceColumn: ProductSortOrder

		annotation SummarizationSetBy = Automatic

	/// Product division. Joins to DimDivision.
	column DivisionId
		dataType: int64
		formatString: 0
		isAvailableInMdx: false
		lineageTag: aa73fdb5-0036-40a6-9fc8-739b2d5d8d31
		summarizeBy: none
		sourceColumn: DivisionId

		annotation SummarizationSetBy = Automatic

	/// Code of the brand owner. Text, so its dropdown slicers offer a search box.
	column BrandId
		dataType: string
		isAvailableInMdx: false
		lineageTag: de052e1f-ffd4-4bb9-a10f-ef7bbd71de05
		summarizeBy: none
		sourceColumn: BrandId

		annotation SummarizationSetBy = Automatic

	/// Brand owner the product is booked under. Usually, not always, the supplier it is bought from: the supplier on a purchase is DimPartner.
	column Brand
		dataType: string
		isAvailableInMdx: false
		lineageTag: 390a2228-7fce-42ec-8561-3e8314deddc6
		summarizeBy: none
		sourceColumn: Brand

		annotation SummarizationSetBy = Automatic

	/// TRUE for goods; FALSE for service and allowance lines, which carry no real cost or price and are kept out of every purchase and cost measure.
	column IsGoods
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: 026d7cc2-0664-4cc8-86ba-7ecfaa98867d
		summarizeBy: none
		sourceColumn: IsGoods

		annotation SummarizationSetBy = Automatic
	partition DimProduct = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // The product catalogue with brand, division and display order.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    CAST(p.ProductId AS VARCHAR(20)) AS ProductId,
				                    p.ProductName,
				                    p.SortOrder AS ProductSortOrder,
				                    p.DivisionId,
				                    CAST(p.BrandId AS VARCHAR(20)) AS BrandId,
				                    b.BrandName AS Brand,
				                    p.IsGoods
				                FROM pur.Product p
				                LEFT JOIN pur.Brand b
				                    ON b.BrandId = p.BrandId
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"ProductId"}, true),
				    Typed = Table.TransformColumnTypes(Keyed, {{"IsGoods", type logical}})
				in
				    Typed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

