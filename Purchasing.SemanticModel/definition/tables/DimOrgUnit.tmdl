/// Organisational units: the warehouses and other units documents are booked in.
table DimOrgUnit
	lineageTag: 504530a2-511e-4de9-b7cb-1a1ac0b6216a

	/// Organisational unit code. Joins FactInvoiceLine[OrgUnitId]; whole number, like it.
	column OrgUnitId
		dataType: int64
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 78cf2a02-2148-43ad-a804-16e0fd72fb6b
		summarizeBy: none
		sourceColumn: OrgUnitId

		annotation SummarizationSetBy = Automatic

	/// Organisational unit name. Sorted by OrgUnitSortOrder.
	column OrgUnitName
		dataType: string
		isAvailableInMdx: false
		lineageTag: 6d4b69f7-d877-4d50-a2df-b026d4e6a56a
		isDefaultLabel
		summarizeBy: none
		sourceColumn: OrgUnitName
		sortByColumn: OrgUnitSortOrder

		annotation SummarizationSetBy = Automatic

	/// Display order of OrgUnitName, from the source: one position per unit name.
	column OrgUnitSortOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: bb81a16a-d5a1-4ed5-8771-c120c0cc287d
		summarizeBy: none
		sourceColumn: OrgUnitSortOrder

		annotation SummarizationSetBy = Automatic
	partition DimOrgUnit = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Organisational units: warehouses and the other units documents are booked in.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    o.OrgUnitId,
				                    o.OrgUnitName,
				                    o.SortOrder AS OrgUnitSortOrder
				                FROM pur.OrgUnit o
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"OrgUnitId"}, true)
				in
				    Keyed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

