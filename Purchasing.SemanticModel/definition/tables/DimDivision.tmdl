/// Product divisions: the commercial book a product is bought and sold under.
table DimDivision
	lineageTag: afe697bd-5bff-46ce-b4ad-23885cc139c9

	/// Division code.
	column DivisionId
		dataType: int64
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: c9c5da1c-9a86-4fee-b56f-6041f8ddf23f
		summarizeBy: none
		sourceColumn: DivisionId

		annotation SummarizationSetBy = Automatic

	/// Division name.
	column DivisionName
		dataType: string
		isAvailableInMdx: false
		lineageTag: ae6e099e-e32a-42c8-940f-811495562934
		isDefaultLabel
		summarizeBy: none
		sourceColumn: DivisionName

		annotation SummarizationSetBy = Automatic
	partition DimDivision = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Product divisions.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    d.DivisionId,
				                    d.DivisionName
				                FROM pur.Division d
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"DivisionId"}, true)
				in
				    Keyed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

