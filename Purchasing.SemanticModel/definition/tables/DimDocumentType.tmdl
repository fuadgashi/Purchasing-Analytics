/// Document types, with the flags that say which documents are purchases and which are sales.
table DimDocumentType
	lineageTag: 63db2466-f322-44d8-b289-47b3e410a1fc

	/// Document type code.
	column DocumentTypeId
		dataType: int64
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: dc3b3e08-5441-4ed7-9d5c-46b85733e330
		summarizeBy: none
		sourceColumn: DocumentTypeId

		annotation SummarizationSetBy = Automatic

	/// Document type name.
	column DocumentTypeName
		dataType: string
		isAvailableInMdx: false
		lineageTag: 66998f1d-12fd-4a74-aedd-d785d3b56221
		isDefaultLabel
		summarizeBy: none
		sourceColumn: DocumentTypeName

		annotation SummarizationSetBy = Automatic

	/// TRUE for document types that bring goods in from a supplier. Every purchase measure filters on it. Not the complement of IsSalesOut: most types are neither.
	column IsPurchase
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: fe391dc8-dbfc-471e-8cf9-5d6eedf26f0f
		summarizeBy: none
		sourceColumn: IsPurchase

		annotation SummarizationSetBy = Automatic

	/// TRUE for document types that move goods out to a customer. Sales and cost of sales filter on it.
	column IsSalesOut
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: 4eb40868-78ed-4484-bdef-d25b61c172bb
		summarizeBy: none
		sourceColumn: IsSalesOut

		annotation SummarizationSetBy = Automatic
	partition DimDocumentType = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Document types, with the purchase and sales flags kept in the source.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    t.DocumentTypeId,
				                    t.DocumentTypeName,
				                    -- a document type the source adds arrives unflagged and counts in no total until it is flagged
				                    t.IsPurchase,
				                    t.IsSalesOut
				                FROM pur.DocumentType t
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"DocumentTypeId"}, true),
				    Typed = Table.TransformColumnTypes(Keyed, {{"IsPurchase", type logical}, {"IsSalesOut", type logical}})
				in
				    Typed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

