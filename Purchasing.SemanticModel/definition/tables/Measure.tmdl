/// The measure host: every business measure of the model, by subject folder.
table Measure
	lineageTag: ff91ef42-d121-499c-9baf-4a52ab3e736a

	/// Percentage difference in purchase invoice count, this year to date against the same period last year. Both sides are year-to-date, so it compares like for like rather than against the whole date-filter window a year back.
	measure 'Index Purchases Invoices Count Actual/Prior YTD' =
			
			IndexDif([Purchases Invoices Count Actual Year], [Purchases Invoices Count Prior Year YTD])
		displayFolder: Purchasing\Invoices Count
		lineageTag: e73a5b95-2296-4d96-9ddc-d5b9ebf4fa15

		formatStringDefinition = IndexFormat(SELECTEDMEASURE(), 0)

	/// Percentage difference of purchase invoices ([Purchases Invoices Count]): the average per month this year to date against the same average per month in the prior year (the date slicers' window one year back), (actual - other) / other. Shown with an arrow, ▲ above and ▼ below.
	measure 'Index Purchases Invoices Count Monthly Average Actual/Prior' =
			
			VAR _avg_month_actual_year = ( AvgDayConst( [Purchases Invoices Count Actual Year] ) * [Working Days per Month] )
			VAR _avg_month_prior_year = ( AvgDayConst( [Purchases Invoices Count Prior Year] ) * [Working Days per Month] )
			RETURN
			IndexDif(_avg_month_actual_year, _avg_month_prior_year)
		displayFolder: Purchasing\Invoices Count
		lineageTag: ed2aac79-d76a-4051-a6cf-9bd28ba0572c

		formatStringDefinition = IndexFormat(SELECTEDMEASURE(), 0)

	/// Percentage difference in the number of products purchased, this year to date against the same period last year. Both sides are year-to-date, so it compares like for like and matches the prior-year figure shown beside it.
	measure 'Index Purchases Products Count Actual/Prior YTD' =
			
			IndexDif([Purchases Products Count Actual Year], [Purchases Products Count Prior Year YTD])
		displayFolder: Purchasing\Products Count
		lineageTag: 5f8aa05b-5d0a-43f3-9b64-90f51785de32

		formatStringDefinition = IndexFormat(SELECTEDMEASURE(), 0)

	/// Percentage difference of quantity bought ([Purchases Quantity]): this year to date against the prior year (the date slicers' window one year back), (actual - other) / other. Shown with an arrow, ▲ above and ▼ below.
	measure 'Index Purchases Quantity Actual/Prior' =
			
			IndexDif([Purchases Quantity Actual Year], [Purchases Quantity Prior Year])
		displayFolder: Purchasing\Quantity
		lineageTag: 9b11aa63-52bf-4fdb-b86f-6e237f0ff037

		formatStringDefinition = IndexFormat(SELECTEDMEASURE(), 0)

		annotation RagColor = UpIsGood

	/// Theme colour name for [Index Purchases Quantity Actual/Prior]: good when it rises, neutral at 0, blank when it is blank. Generated by scripts/rag_colors.py from the RagColor annotation on [Index Purchases Quantity Actual/Prior]; edit the annotation, not this measure.
	measure 'Index Purchases Quantity Actual/Prior Color' = RagColor( [Index Purchases Quantity Actual/Prior], 0 )
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: 1390b48c-b84d-4461-ac70-67fa695a8d47

		annotation PBI_FormatHint = {"isText":true}

	/// Percentage difference in purchase quantity, this year to date against the same period last year. Unlike 'Index Purchases Quantity Actual/Prior', whose prior side is the whole date-filter window a year back (not cut at today's date), both sides here stop at the same day.
	measure 'Index Purchases Quantity Actual/Prior YTD' =
			
			IndexDif([Purchases Quantity Actual Year], [Purchases Quantity Prior Year YTD])
		displayFolder: Purchasing\Quantity
		lineageTag: 17add9f9-07ff-47da-a0b2-bfe87d118afc

		formatStringDefinition = IndexFormat(SELECTEDMEASURE(), 0)

	/// Percentage difference of quantity bought ([Purchases Quantity]): the average per month this year to date against the same average per month in the prior year (the date slicers' window one year back), (actual - other) / other. Shown with an arrow, ▲ above and ▼ below.
	measure 'Index Purchases Quantity Monthly Average Actual/Prior' =
			
			VAR _avg_month_actual_year = ( AvgDayConst( [Purchases Quantity Actual Year] ) * [Working Days per Month] )
			VAR _avg_month_prior_year = ( AvgDayConst( [Purchases Quantity Prior Year] ) * [Working Days per Month] )
			RETURN
			IndexDif(_avg_month_actual_year, _avg_month_prior_year)
		displayFolder: Purchasing\Quantity
		lineageTag: 029276aa-58c5-4650-9699-b7f6e3835eba

		formatStringDefinition = IndexFormat(SELECTEDMEASURE(), 0)

	/// Percentage difference of purchases ([Purchases Value]): this year to date against the prior year (the date slicers' window one year back), (actual - other) / other. Shown with an arrow, ▲ above and ▼ below.
	measure 'Index Purchases Value Actual/Prior' =
			
			IndexDif([Purchases Value Actual Year], [Purchases Value Prior Year])
		displayFolder: Purchasing\Value
		lineageTag: 1bfcfc89-efb4-40a4-829a-71b417ac8563

		formatStringDefinition = IndexFormat(SELECTEDMEASURE(), 0)

		annotation RagColor = UpIsGood

	/// Theme colour name for [Index Purchases Value Actual/Prior]: good when it rises, neutral at 0, blank when it is blank. Generated by scripts/rag_colors.py from the RagColor annotation on [Index Purchases Value Actual/Prior]; edit the annotation, not this measure.
	measure 'Index Purchases Value Actual/Prior Color' = RagColor( [Index Purchases Value Actual/Prior], 0 )
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: c2584fbb-64cd-4810-ab27-b0f4d18840d2

		annotation PBI_FormatHint = {"isText":true}

	/// Percentage difference in purchase value, this year to date against the same period last year. Unlike 'Index Purchases Value Actual/Prior', whose prior side is the whole date-filter window a year back (not cut at today's date), both sides here stop at the same day.
	measure 'Index Purchases Value Actual/Prior YTD' =
			
			IndexDif([Purchases Value Actual Year], [Purchases Value Prior Year YTD])
		displayFolder: Purchasing\Value
		lineageTag: 8b45a29d-ff58-4a33-b480-e57963ef9cbb

		formatStringDefinition = IndexFormat(SELECTEDMEASURE(), 0)

	/// Percentage difference of purchases ([Purchases Value]): the average per month this year to date against the same average per month in the prior year (the date slicers' window one year back), (actual - other) / other. Shown with an arrow, ▲ above and ▼ below.
	measure 'Index Purchases Value Monthly Average Actual/Prior' =
			
			VAR _avg_month_actual_year = ( AvgDayConst( [Purchases Value Actual Year] ) * [Working Days per Month] )
			VAR _avg_month_prior_year = ( AvgDayConst( [Purchases Value Prior Year] ) * [Working Days per Month] )
			RETURN
			IndexDif(_avg_month_actual_year, _avg_month_prior_year)
		displayFolder: Purchasing\Value
		lineageTag: e5e7497a-432d-42b6-b8de-0c39c8147311

		formatStringDefinition = IndexFormat(SELECTEDMEASURE(), 0)

	/// Average purchase value per dropped product, measured on last year's buying for the same period.
	measure 'Purchases Dropped Product Avg Value' =
			
			DIVIDE([Purchases Dropped Product Value], [Purchases Dropped Products Count])
		formatString: #,0
		displayFolder: Purchasing\Value
		lineageTag: a0cb3c15-eb33-499f-b2e5-aa58ef892d37

	/// Share of this year's sales still coming from products that are no longer being purchased - bought in the same period last year, not bought since. With a supplier picked: the products no longer bought from that supplier, set against all sales. The sales side ignores the partner filter. A high figure means stock is selling without being replenished. Percentage.
	measure 'Purchases Dropped Product Sales Share' =
			
			-- The products come from the purchases, under every slicer, the supplier included. Their sales
			-- ignore the partner: on a sales line the partner is a customer, so a supplier pick would leave
			-- no sales to divide.
			VAR _scope =
			    ADDCOLUMNS(
			        CALCULATETABLE(VALUES(DimProduct[ProductId])),
			        "@cy", CALCULATE([Purchases Quantity Actual Year]),
			        "@py", CALCULATE([Purchases Quantity Prior Year YTD]),
			        "@s", CALCULATE([Sales Net Price Actual Year], REMOVEFILTERS(DimPartner))
			    )
			RETURN
			    DIVIDE(
			        SUMX(FILTER(_scope, NOT([@cy] > 0) && [@py] > 0), [@s]),
			        CALCULATE([Sales Net Price Actual Year], REMOVEFILTERS(DimPartner))
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Purchasing\Products Count
		lineageTag: 084735cc-1012-4fef-802b-032f7b2c8d46

	/// Purchase value in the same period last year of products that have not been bought this year. Returned as a positive magnitude.
	measure 'Purchases Dropped Product Value' =
			
			VAR _scope =
			    ADDCOLUMNS(
			        CALCULATETABLE(VALUES(DimProduct[ProductId])),
			        "@cy", CALCULATE([Purchases Quantity Actual Year]),
			        "@py", CALCULATE([Purchases Quantity Prior Year YTD]),
			        "@v", CALCULATE([Purchases Value Prior Year YTD])
			    )
			RETURN
			    SUMX(FILTER(_scope, NOT([@cy] > 0) && [@py] > 0), [@v])
		formatString: #,0
		displayFolder: Purchasing\Value
		lineageTag: 4fc2c789-c03f-47e6-b5ea-bace646de1dd

	/// Products bought in the same period last year that have not been bought so far this year.
	measure 'Purchases Dropped Products Count' =
			
			VAR _scope =
			    ADDCOLUMNS(
			        CALCULATETABLE(VALUES(DimProduct[ProductId])),
			        "@cy", CALCULATE([Purchases Quantity Actual Year]),
			        "@py", CALCULATE([Purchases Quantity Prior Year YTD])
			    )
			RETURN
			    COUNTROWS(FILTER(_scope, NOT([@cy] > 0) && [@py] > 0))
		formatString: #,0
		displayFolder: Purchasing\Products Count
		lineageTag: 2260e779-3d91-4542-b260-0e1af17b1bf9

	/// Purchase invoices: distinct purchase documents, goods only. Whole number.
	measure 'Purchases Invoices Count' =
			
			CALCULATE(
				DISTINCTCOUNT(
			        FactInvoiceLine[DocumentId]),
			        DimDocumentType[IsPurchase] = TRUE,
			        -- Goods only: service and allowance lines are not purchases of goods.
			        DimProduct[IsGoods] = TRUE
			)
		formatString: #,0
		displayFolder: Calculation Roots\Purchases
		lineageTag: 2674d5ab-815c-44e8-8a35-0ce41883c6e9

	/// Purchase invoices ([Purchases Invoices Count]), this year to date: the date slicers' window within this year, cut at today (1 January to today when no slicer is set). Whole number.
	measure 'Purchases Invoices Count Actual Year' =
			
			YearToDay([Purchases Invoices Count])
		formatString: #,0
		displayFolder: Purchasing\Invoices Count
		lineageTag: 8da2beb8-924e-4680-97a6-5597fc686ae4

	/// Purchase invoices ([Purchases Invoices Count]) per month this year to date: the average per working day times the working days in a month. The date slicers do not change it. Whole number per month.
	measure 'Purchases Invoices Count Actual Year Monthly Average' =
			
			( AvgDayConst( [Purchases Invoices Count Actual Year] ) * [Working Days per Month] )
		formatString: #,0
		displayFolder: Purchasing\Invoices Count
		lineageTag: 79384129-c85c-4154-9845-7f1e9423d9cd

	/// Purchase invoices ([Purchases Invoices Count]), in the prior year: the date slicers' window one year back, inside last calendar year. Whole number.
	measure 'Purchases Invoices Count Prior Year' =
			
			PrevYear([Purchases Invoices Count])
		formatString: #,0
		displayFolder: Purchasing\Invoices Count
		lineageTag: 2abeaa06-966c-4534-9a85-52186e6dd757

	/// Purchase invoices ([Purchases Invoices Count]), in the prior year up to the same day: the date slicers' window cut at today, one year back (1 January to today's date one year back when no slicer is set). Whole number.
	measure 'Purchases Invoices Count Prior Year YTD' =
			
			YearToDay([Purchases Invoices Count Prior Year])
		formatString: 0
		displayFolder: Purchasing\Invoices Count
		lineageTag: fca4107d-0804-4a24-8f32-8e6c83ed774c

	/// Average purchase value per newly introduced product. New-product value divided by the number of new products - a low figure means most introductions never scaled beyond a trial order.
	measure 'Purchases New Product Avg Value' =
			
			DIVIDE([Purchases New Product Value], [Purchases New Products Count])
		formatString: #,0
		displayFolder: Purchasing\Value
		lineageTag: 050a7fdc-df35-47d6-b08e-10aae23b4568

	/// Share of this year's sales that comes from products introduced this year - products bought now that were not bought in the same period last year. With a supplier picked: the products newly bought from that supplier, set against all sales. The sales side ignores the partner filter. A low figure means new listings are not yet earning their place. Percentage.
	measure 'Purchases New Product Sales Share' =
			
			-- The products come from the purchases, under every slicer, the supplier included. Their sales
			-- ignore the partner: on a sales line the partner is a customer, so a supplier pick would leave
			-- no sales to divide.
			VAR _scope =
			    ADDCOLUMNS(
			        CALCULATETABLE(VALUES(DimProduct[ProductId])),
			        "@cy", CALCULATE([Purchases Quantity Actual Year]),
			        "@py", CALCULATE([Purchases Quantity Prior Year YTD]),
			        "@s", CALCULATE([Sales Net Price Actual Year], REMOVEFILTERS(DimPartner))
			    )
			RETURN
			    DIVIDE(
			        SUMX(FILTER(_scope, [@cy] > 0 && NOT([@py] > 0)), [@s]),
			        CALCULATE([Sales Net Price Actual Year], REMOVEFILTERS(DimPartner))
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Purchasing\Products Count
		lineageTag: 6136a9b9-cc01-48db-bbe0-1d1c5e0d56a2

	/// Purchase value so far this year of products that were not bought in the same period last year.
	measure 'Purchases New Product Value' =
			
			VAR _scope =
			    ADDCOLUMNS(
			        CALCULATETABLE(VALUES(DimProduct[ProductId])),
			        "@cy", CALCULATE([Purchases Quantity Actual Year]),
			        "@py", CALCULATE([Purchases Quantity Prior Year YTD]),
			        "@v", CALCULATE([Purchases Value Actual Year])
			    )
			RETURN
			    SUMX(FILTER(_scope, [@cy] > 0 && NOT([@py] > 0)), [@v])
		formatString: #,0
		displayFolder: Purchasing\Value
		lineageTag: 38d54812-4e07-41f5-8444-28c98d635b64

	/// Products bought so far this year that were not bought in the same period last year. Counts whether a product was bought, not how much.
	measure 'Purchases New Products Count' =
			
			VAR _scope =
			    ADDCOLUMNS(
			        CALCULATETABLE(VALUES(DimProduct[ProductId])),
			        "@cy", CALCULATE([Purchases Quantity Actual Year]),
			        "@py", CALCULATE([Purchases Quantity Prior Year YTD])
			    )
			RETURN
			    COUNTROWS(FILTER(_scope, [@cy] > 0 && NOT([@py] > 0)))
		formatString: #,0
		displayFolder: Purchasing\Products Count
		lineageTag: 43a04f6b-cab7-4353-8150-5a2b68f4ceb8

	/// Distinct products bought on purchase documents, goods only. Whole number.
	measure 'Purchases Products Count' =
			
			CALCULATE(
				DISTINCTCOUNT(
			        FactInvoiceLine[ProductId]),
			        DimDocumentType[IsPurchase] = TRUE,
			        -- Goods only: service and allowance lines are not purchases of goods.
			        DimProduct[IsGoods] = TRUE
			)
		formatString: #,0
		displayFolder: Calculation Roots\Purchases
		lineageTag: 0ec6d242-3d00-4d85-8342-2962c455bb27

	/// Distinct products bought ([Purchases Products Count]), this year to date: the date slicers' window within this year, cut at today (1 January to today when no slicer is set). Whole number.
	measure 'Purchases Products Count Actual Year' =
			
			YearToDay([Purchases Products Count])
		formatString: #,0
		displayFolder: Purchasing\Products Count
		lineageTag: 1457b557-7699-4f46-b743-272926e7e20e

	/// Distinct products bought ([Purchases Products Count]), in the prior year: the date slicers' window one year back, inside last calendar year. Whole number.
	measure 'Purchases Products Count Prior Year' =
			
			PrevYear([Purchases Products Count])
		formatString: #,0
		displayFolder: Purchasing\Products Count
		lineageTag: fd89a6bd-e940-4443-8315-f49ddadcc53a

	/// Distinct products bought ([Purchases Products Count]), in the prior year up to the same day: the date slicers' window cut at today, one year back (1 January to today's date one year back when no slicer is set). Whole number.
	measure 'Purchases Products Count Prior Year YTD' =
			
			YearToDay([Purchases Products Count Prior Year])
		formatString: #,0
		displayFolder: Purchasing\Products Count
		lineageTag: 659320da-5b26-4ccf-b0c6-b2104398a3b6

	/// Quantity bought on purchase documents, goods only. Units.
	measure 'Purchases Quantity' =
			
			CALCULATE(
			    SUM(FactInvoiceLine[Quantity]),
			    DimDocumentType[IsPurchase] = TRUE,
			    -- Goods only: service and allowance lines are not purchases of goods.
			    DimProduct[IsGoods] = TRUE
			)
		formatString: #,0
		displayFolder: Calculation Roots\Purchases
		lineageTag: 6bc0ce2f-d2a2-46eb-bde5-a5563d791f1e

	/// Quantity bought ([Purchases Quantity]), this year to date: the date slicers' window within this year, cut at today (1 January to today when no slicer is set). Units.
	measure 'Purchases Quantity Actual Year' =
			
			YearToDay([Purchases Quantity])
		formatString: #,0
		displayFolder: Purchasing\Quantity
		lineageTag: 16443bae-8ffe-48c0-8ba9-51255a976207

	/// Quantity bought ([Purchases Quantity]) per month this year to date: the average per working day times the working days in a month. The date slicers do not change it. Units per month.
	measure 'Purchases Quantity Actual Year Monthly Average' =
			
			( AvgDayConst( [Purchases Quantity Actual Year] ) * [Working Days per Month] )
		formatString: #,0
		displayFolder: Purchasing\Quantity
		lineageTag: bab952c0-247d-4852-be32-d2f05dfe540a

	/// Quantity bought ([Purchases Quantity]), in the prior year: the date slicers' window one year back, inside last calendar year. Units.
	measure 'Purchases Quantity Prior Year' =
			
			PrevYear([Purchases Quantity])
		formatString: #,0
		displayFolder: Purchasing\Quantity
		lineageTag: 88e2f98f-7cd5-4f86-a901-34c749580660

	/// Quantity bought ([Purchases Quantity]), in the prior year up to the same day: the date slicers' window cut at today, one year back (1 January to today's date one year back when no slicer is set). Units.
	measure 'Purchases Quantity Prior Year YTD' =
			
			YearToDay([Purchases Quantity Prior Year])
		formatString: #,0
		displayFolder: Purchasing\Quantity
		lineageTag: dd013052-77cc-4faf-af70-416525644823

	/// Purchase value: quantity times the supplier price, after discounts and without VAT, on purchase documents, goods only. What the suppliers charged: transport, customs and other costs of bringing goods in are not in it. Value.
	measure 'Purchases Value' =
			
			-- Net of discount and without VAT: the price with VAT would overstate purchases, and
			-- supplier discounts are taken off.
			CALCULATE(
			    SUMX( FactInvoiceLine, FactInvoiceLine[Quantity] * FactInvoiceLine[SupplierPrice] ),
			    DimDocumentType[IsPurchase] = TRUE,
			    -- Goods only: service and allowance lines are not purchases of goods.
			    DimProduct[IsGoods] = TRUE
			)
		formatString: #,0
		displayFolder: Calculation Roots\Purchases
		lineageTag: cf8e4a93-c48e-44b3-b2ad-ebd94790fdef

	/// Purchases ([Purchases Value]), this year to date: the date slicers' window within this year, cut at today (1 January to today when no slicer is set). Value.
	measure 'Purchases Value Actual Year' =
			
			YearToDay([Purchases Value])
		formatString: #,0
		displayFolder: Purchasing\Value
		lineageTag: 5975f150-5c59-4fbd-906f-57aa48f2169c

		changedProperty = IsHidden

	/// Purchases ([Purchases Value]) per month this year to date: the average per working day times the working days in a month. The date slicers do not change it. Value per month.
	measure 'Purchases Value Actual Year Monthly Average' =
			
			( AvgDayConst( [Purchases Value Actual Year] ) * [Working Days per Month] )
		formatString: #,0
		displayFolder: Purchasing\Value
		lineageTag: d4255719-5561-47b6-9877-5fee4d8a3653

	/// Each supplier's share of purchase value this year to date. The supplier is the partner on the purchase document. The denominator is every supplier (REMOVEFILTERS on DimPartner), so a Top N chart shows each bar's real share of the total and the Supplier slicer does not inflate it; the date, product and organisational-unit slicers narrow both sides. Percentage.
	measure 'Purchases Value Actual Year Share' =
			
			DIVIDE(
			    [Purchases Value Actual Year],
			    CALCULATE(
			        [Purchases Value Actual Year],
			        REMOVEFILTERS(DimPartner)
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Purchasing\Value
		lineageTag: b9b17982-08c5-409d-90ed-625107836f99

	/// Purchases ([Purchases Value]), in the prior year: the date slicers' window one year back, inside last calendar year. Value.
	measure 'Purchases Value Prior Year' =
			
			PrevYear([Purchases Value])
		formatString: #,0
		displayFolder: Purchasing\Value
		lineageTag: 7be002cd-954a-4a3a-b67f-bd95b5b9a0d3

	/// Purchases ([Purchases Value]), in the prior year up to the same day: the date slicers' window cut at today, one year back (1 January to today's date one year back when no slicer is set). Value.
	measure 'Purchases Value Prior Year YTD' =
			
			YearToDay([Purchases Value Prior Year])
		formatString: #,0
		displayFolder: Purchasing\Value
		lineageTag: 5a7d4091-ef4a-42d8-ad36-a5c069e9cc1f

	/// Net sales: quantity times the net price the customer pays, after discounts and with VAT, on sales-out documents. The one sales figure of the model: call it, never rebuild it. Value.
	measure 'Sales Net Price' =
			
			CALCULATE(
			    SUMX(
			        FactInvoiceLine,
			        FactInvoiceLine[Quantity] * FactInvoiceLine[NetPrice]),
			    DimDocumentType[IsSalesOut] = TRUE
			)
		displayFolder: Calculation Roots\Sales
		lineageTag: 389835d4-dae5-4b0f-9a67-c6daac0e8f9a

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

	/// Net sales ([Sales Net Price]), this year to date: the date slicers' window within this year, cut at today (1 January to today when no slicer is set). Value.
	measure 'Sales Net Price Actual Year' =
			
			YearToDay([Sales Net Price])
		displayFolder: Sales\Net Price
		lineageTag: 08aea34b-0af2-4389-bf91-ab170e14cc94

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

		changedProperty = IsHidden

	/// Net change in the purchased range: products added this year minus products dropped. Equals this year's product count minus last year's for the same period.
	measure 'Variance Purchases Products Count New/Dropped' =
			
			[Purchases New Products Count] - [Purchases Dropped Products Count]
		formatString: +#,0;-#,0;#,0
		displayFolder: Purchasing\Products Count
		lineageTag: aaf41d62-abbc-4555-b6d1-3c59f88cddfa

	/// Average working days in a month, read from the calendar: its working days divided by its months. Days. Turns a per-day average into a monthly one.
	measure 'Working Days per Month' =
			DIVIDE(
				CALCULATE( SUM( DimDate[Working Day] ), REMOVEFILTERS( DimDate ) ),
				CALCULATE( DISTINCTCOUNT( DimDate[YearMonthKey] ), REMOVEFILTERS( DimDate ) )
			)
		formatString: 0.00
		isHidden
		displayFolder: Calendar\Working Days
		lineageTag: d33e039b-19eb-42f0-b3ea-cc8dc869f180

	partition Measure = m
		mode: import
		queryGroup: Model
		source =
				let
				    // Query group: Model
				    // Generic measure-table scaffold - an empty table that hosts measures
				    // only. Zero columns by design: with no visible columns and at least
				    // one measure, Power BI shows the calculator icon and pins the table
				    // to the top of the Fields pane.
				    Source = #table({}, {})
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

